# Project config read by scripts/*.sh. Shell syntax.
NAME=hj60_coolant
PURPOSE="HJ60 coolant temperature from the factory gauge sender, with OLED and buzzer alarm"

# Real hardware (firmware/)
BOARD="ESP32 DevKit V1 (WROOM-32)"
FQBN=esp32:esp32:esp32
BAUD=115200

# Emulator (emulator/wokwi/)
SIM_BOARD="ESP32 DevKit C v4"
SIM_FQBN=esp32:esp32:esp32
# Space-separated sim-only library dirs (relative to this folder), passed with --library.
SIM_SHIMS="emulator/wokwi/shims/DIYables_TFT_SPI_SimShim"
# The OLED screenshot kept wokwi-cli running after the ESP32 scenario passed (2026-11-01).
SIM_SCREENSHOT=off
