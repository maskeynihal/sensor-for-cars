# Project config read by scripts/*.sh. Shell syntax.
NAME=water_monitor
PURPOSE="Water + air temperature monitor with animated OLED and buzzer alarm"

# Real hardware (firmware/)
BOARD="Arduino UNO R4 WiFi"
FQBN=arduino:renesas_uno:unor4wifi
BAUD=9600

# Emulator (emulator/wokwi/) -- Wokwi cannot run the R4 (RA4M1), so the
# sim copy targets an AVR Uno. See docs/adr/0004-two-tier-emulation.md.
SIM_BOARD="Arduino Uno (ATmega328P)"
SIM_FQBN=arduino:avr:uno
# Space-separated sim-only library dirs passed with --library (highest priority).
SIM_SHIMS="emulator/wokwi/shims/Adafruit_SH110X_SimShim"
